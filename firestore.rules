rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Public readable content
    match /site_settings/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    match /rooms/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    match /faqs/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    match /gallery_images/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    match /testimonials/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }
    
    match /contacts/{docId} {
      allow read: if isAuthenticated();
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }
    
    match /pages/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    match /page_versions/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Reservations & Guest interactions
    match /reservations/{docId} {
      allow read: if isAuthenticated() && (resource.data.user_id == request.auth.uid || true);
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }
    
    match /guest_messages/{docId} {
      allow read, write: if isAuthenticated();
    }
    
    match /change_requests/{docId} {
      allow read, write: if isAuthenticated();
    }
    
    match /audit_logs/{docId} {
      allow read, write: if isAuthenticated();
    }
    
    match /user_roles/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
